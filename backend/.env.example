# Server
PORT=4000
# Allowed frontend origin(s) for CORS, comma separated (use * in local dev)
CORS_ORIGIN=http://localhost:3000
# MongoDB connection string (Atlas or local). If empty in development, an in-memory MongoDB is started.
MONGODB_URI=mongodb://127.0.0.1:27017/memed
# Long random string used to sign JWTs
# Database name used inside the cluster
MONGODB_DB=memed
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
